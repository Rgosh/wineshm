# Maintainer: Rgosh <rgoshbbb@gmail.com>
pkgname=wineshm
pkgver=0.6.1
pkgrel=1
pkgdesc="Expose a Windows program's named shared memory to Linux, from inside a Wine or Proton prefix"
arch=('x86_64')
url="https://github.com/Rgosh/wineshm"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo')
optdepends=('steam: to find a game prefix with --appid'
            'db7b435712ed9369184b62e50d8da258349c293f5e24a922fb87e0c6af31ae37')
# **The Windows half comes from the release rather than being built here.**
# Cross-building it needs the x86_64-pc-windows-gnu standard library, which
# Arch's `rust` does not ship and which a package has no business installing
# into somebody's toolchain. The release binary is built by CI from this same
# tag — see .github/workflows/release.yml — and is checksummed below, so what
# is installed is still tied to the source being built beside it.
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "$pkgname-$pkgver.exe::$url/releases/download/v$pkgver/wineshm.exe")
sha256sums=('62780e6cdaa41875f06b5ba9b5626ecaba313db10c5cbbcb19a9c31d91f7169f'
            'db7b435712ed9369184b62e50d8da258349c293f5e24a922fb87e0c6af31ae37')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 target/release/wineshm "$pkgdir/usr/bin/wineshm"

  # Not /usr/bin: a Windows executable is not something to put on anybody's
  # PATH. The program looks here by itself — see launch::exe_candidates.
  install -Dm644 "$srcdir/$pkgname-$pkgver.exe" "$pkgdir/usr/lib/$pkgname/wineshm.exe"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  for recipe in recipes/*; do
    install -Dm644 "$recipe" "$pkgdir/usr/share/$pkgname/recipes/$(basename "$recipe")"
  done
}
